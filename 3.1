#include <stdio.h>
#include <string.h>
#include <ctype.h>

enum commandType { ADD, SCHEDULE, PICK, DROP, MOVE, CREATE, INVALID };

enum commandType getCommandType(char* command) {
    char w[10];
    int i;
    int vtri = 0;

    // Bỏ qua khoảng trắng đầu chuỗi
    for (i = 0; command[i] != '\0' && isspace((unsigned char)command[i]); i++);

    // Tách từ đầu tiên và chuyển về chữ thường (tối đa 9 ký tự)
    for (; command[i] != '\0' && !isspace((unsigned char)command[i]); i++) {
        if (vtri < 9) {
            w[vtri++] = (char)tolower((unsigned char)command[i]);
        }
    }
    w[vtri] = '\0';

    if (strcmp(w, "add") == 0)
        return ADD;
    else if (strcmp(w, "schedule") == 0)
        return SCHEDULE;
    else if (strcmp(w, "pick") == 0)
        return PICK;
    else if (strcmp(w, "drop") == 0)
        return DROP;
    else if (strcmp(w, "move") == 0)
        return MOVE;
    else if (strcmp(w, "create") == 0)
        return CREATE;
    else
        return INVALID;
}

int main() {
    char s[200];
    const char* ten[] = {"ADD", "SCHEDULE", "PICK", "DROP", "MOVE", "CREATE", "INVALID"};

    if (fgets(s, sizeof(s), stdin) != NULL) {
        enum commandType kq = getCommandType(s);
        printf("%s\n", ten[kq]);
    }

    return 0;
}
	

	
