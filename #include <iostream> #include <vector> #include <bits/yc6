using namespace std;
using ll = long long;

int countPath(int**map, int mapSize) {
	int count = 0 ;
	for (int i=0;i<mapSize;i++) {
		for (int j=i+1;j<mapSize;j++) {
			if (map[i][j] !=0 ){
			count++; }
		}
	}
	return count;
}
