void createMapFromDescription(char* description, int** map) {
    if (checkDescription(description) != -1) {
        printf("Invalid Description!");
        return;
    }

    int d[3];
    int count = 0;
    int length = strlen(description);

    for (int i = 0; i < length; i++) {
        if (description[i] >= '0' && description[i] <= '9') {
            int num = 0;
            while (i < length && description[i] >= '0' && description[i] <= '9') {
                num = num * 10 + (description[i] - '0');
                i++;
            }
            i--;

            d[count] = num;
            count++;

            if (count == 3) {
                map[d[0]][d[1]] = d[2];
                map[d[1]][d[0]] = d[2];
                count = 0;
            }
        }
    }
}
