void createMapFromDescription(char* description, int** map) {
    if (checkDescription(description) != -1) {
        printf("Invalid Description!");
        return;
    }

    // Lượt 1: tìm chỉ số địa điểm lớn nhất để reset vùng map về 0
    int vals[3], cnt = 0, maxIdx = 0;
    for (int i = 0; description[i] != '\0'; i++) {
        char c = description[i];
        if (c >= '0' && c <= '9') {
            vals[cnt++] = c - '0';
            if (cnt == 3) {
                if (vals[0] > maxIdx) maxIdx = vals[0];
                if (vals[1] > maxIdx) maxIdx = vals[1];
                cnt = 0;
            }
        }
    }
    for (int i = 0; i <= maxIdx; i++)
        for (int j = 0; j <= maxIdx; j++)
            map[i][j] = 0;

    // Lượt 2: mỗi câu có đúng 3 chữ số theo thứ tự <F>, <T>, <D>
    cnt = 0;
    for (int i = 0; description[i] != '\0'; i++) {
        char c = description[i];
        if (c >= '0' && c <= '9') {
            vals[cnt++] = c - '0';
            if (cnt == 3) {
                map[vals[0]][vals[1]] = vals[2];
                map[vals[1]][vals[0]] = vals[2];  // bản đồ đối xứng
                cnt = 0;
            }
        }
    }
}
